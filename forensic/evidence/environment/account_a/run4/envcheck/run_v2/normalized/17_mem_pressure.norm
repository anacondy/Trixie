pagetables <BIGNUM>
sec_pagetables 0
percpu 0
sock 0

$ echo 'memory.stat key fields:'; CG=/sys/fs/cgroup$(awk -F: '$1==0{print $3}' /proc/self/cgroup); grep -E '^(anon|file|slab|kernel_stack|pagetables|sock|shmem|dirty|writeback|inactive_anon|active_anon|workingset_refault)' $CG/memory.stat 2>&1 | sort
