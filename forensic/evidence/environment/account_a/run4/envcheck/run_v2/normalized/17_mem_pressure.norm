$ CG=/sys/fs/cgroup$(awk -F: '$1==0{print $3}' /proc/self/cgroup); echo 'limit/current/events:'; for f in memory.max memory.high memory.current memory.events memory.stat; do echo "-- $f"; cat $CG/$f 2>&1 | head -8; done
