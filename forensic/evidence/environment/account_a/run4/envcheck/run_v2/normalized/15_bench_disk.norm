$ if sudo -n sh -c 'sync; echo 3 > /proc/sys/vm/drop_caches' 2>/dev/null; then dd if=/dev/zero of=./probe_c.bin bs=1M count=100 conv=fsync >/dev/null 2>&1; sync; sudo -n sh -c 'echo 3 > /proc/sys/vm/drop_caches'; dd if=./probe_c.bin of=/dev/null bs=1M 2>&1 | tail -1; echo '  (above = COLD read, caches dropped)'; rm -f probe_c.bin; else echo '  drop_caches unavailable (no sudo) - cold-read test skipped'; fi
