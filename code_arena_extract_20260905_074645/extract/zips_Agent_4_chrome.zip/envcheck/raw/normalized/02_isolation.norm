$ CG=/sys/fs/cgroup$(awk -F: '$1==0{print $3}' /proc/self/cgroup); echo "cgroup dir: $CG"; for f in cpu.max cpu.weight cpuset.cpus.effective memory.max memory.high memory.current memory.swap.max pids.max io.max; do printf '%-<T> %s\n' $f "$(cat $CG/$f 2>&1 | head -1)"; done
cgroup dir: /sys/fs/cgroup/user
cpu.max current <N>|max <N>
cpu.weight <N>
cpuset.cpus.effective 0-1
memory.max <N>
memory.high <N>
memory.current <N>
memory.swap.max max
pids.max max
io.max

$ CG=/sys/fs/cgroup$(awk -F: '$1==0{print $3}' /proc/self/cgroup); echo '--- cpu.stat ---'; cat $CG/cpu.stat 2>&1; echo '--- memory.events ---'; cat $CG/memory.events 2>&1
